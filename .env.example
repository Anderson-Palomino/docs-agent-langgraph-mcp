OPENAI_API_KEY=sk-...
DATABASE_URL=postgresql://docs:docs@127.0.0.1:5434/docs
# Tests use docs_test; to override, export TEST_DATABASE_URL in the shell (it is not read from this file).
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
FASTAPI_DOCS_REF=0.162.0
TOP_K=5
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
ASK_DAILY_TOKEN_BUDGET=200000
INGEST_MAX_TOKENS=2000000
NO_ANSWER_DISTANCE_THRESHOLD=0.52
# Budget the MCP server spends: mcp when Claude launches it; the API launches it with ask (D29).
MCP_BUDGET_SCOPE=mcp
MCP_DAILY_TOKEN_BUDGET=100000
MCP_CALL_TIMEOUT_S=15
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=docs-agent
PRICE_CHAT_INPUT_PER_MTOK=0.40
PRICE_CHAT_OUTPUT_PER_MTOK=1.60
PRICE_EMBEDDING_PER_MTOK=0.02
