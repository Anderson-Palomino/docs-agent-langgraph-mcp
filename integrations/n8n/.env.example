# Copiar a .env (ignorado por git). Aquí no van secretos:
# las credenciales (OpenAI, Postgres, token MCP) viven solo dentro de n8n.
GENERIC_TIMEZONE=America/Lima
TZ=America/Lima
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# Token del MCP Server Trigger: generarlo con `openssl rand -hex 32`.
# Vive aquí (.env, ignorado), en la credencial Bearer de n8n y en la config local de Claude Code.
N8N_MCP_TOKEN=
